# Public site URL. Use your Vercel production URL or custom domain.
APP_URL=https://aimetadataeraser.vercel.app

# Comma-separated front-end origins allowed to call the API.
# If you keep GitHub Pages as the front end, include that URL too.
ALLOWED_ORIGINS=https://aimetadataeraser.vercel.app

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# Vercel KV or Upstash Redis REST credentials.
KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=replace-with-kv-token

# Optional email-code delivery. Without these, the dev code is returned in the API response.
RESEND_API_KEY=re_replace-with-resend-key
EMAIL_FROM=File Cleaner <login@yourdomain.com>

# Stripe subscription billing.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_monthly_10_usd
STRIPE_PRICE_YEARLY=price_replace_yearly_89_usd

# Optional Google/Gmail registration.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
